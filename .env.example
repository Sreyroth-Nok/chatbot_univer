# Copy this file to .env and fill in your values. Never commit .env to GitHub.

# --- Django ---
DEBUG=True
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1
# Websites allowed to embed the chat widget (comma-separated, with https://)
CORS_ALLOWED_ORIGINS=http://localhost:8000
CSRF_TRUSTED_ORIGINS=http://localhost:8000

# --- Database (matches docker-compose.yml) ---
POSTGRES_DB=chatbot
POSTGRES_USER=chatbot
POSTGRES_PASSWORD=chatbot-dev-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- University ---
UNIVERSITY_NAME=Our University

# --- AI model ---
# Leave empty during early development: the bot then replies with the best
# matching FAQ answer directly, without calling the AI model.
#
# Claude (paid):            LLM_PROVIDER=anthropic, LLM_MODEL=claude-haiku-5-5
# Google Gemini (free tier, key from aistudio.google.com):
#   LLM_PROVIDER=openai
#   LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   LLM_MODEL=gemini-flash-latest
#   LLM_REASONING_EFFORT=low
# Groq / OpenRouter / Ollama also work with LLM_PROVIDER=openai + their base URL.
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=claude-haiku-5-5
LLM_REASONING_EFFORT=

# Embeddings: "e5" = real multilingual model (Khmer + English, downloads ~500 MB once)
#             "hash" = fast keyword-style vectors for weak laptops and tests
EMBEDDING_BACKEND=e5
EMBEDDING_MODEL=intfloat/multilingual-e5-small

# Retrieval tuning (tune during the Sprint 9 accuracy test)
RAG_TOP_K=4
# Leave empty to use the default for the chosen embedding backend
RAG_MAX_DISTANCE=

# --- Telegram (get a token from @BotFather) ---
TELEGRAM_BOT_TOKEN=
